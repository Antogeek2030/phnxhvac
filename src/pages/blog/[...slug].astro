---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---
<Layout title={`${post.data.title} | HVAC Repair Phoenixville`} description={post.data.description}>
  <section class="page-hero">
    <div class="container">
      <div class="blog-meta" style="opacity:0.8;margin-bottom:0.5rem">{post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })} · {post.data.author}</div>
      <h1>{post.data.title}</h1>
    </div>
  </section>
  <section class="section">
    <div class="container prose">
      <Content />
      <p style="margin-top:2.5rem"><a href="/blog/" class="btn btn-outline-dark">← Back to Blog</a></p>
    </div>
  </section>
</Layout>
