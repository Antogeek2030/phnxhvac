---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---
<Layout title="HVAC Tips & Blog | Phoenixville PA" description="Practical HVAC tips, maintenance advice, and local guides for Phoenixville and Chester County homeowners.">
  <section class="page-hero">
    <div class="container">
      <h1>HVAC Tips & Guides</h1>
      <p>Practical advice to keep your heating and cooling systems running smoothly.</p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="blog-grid">
        {posts.map((post) => (
          <a href={`/blog/${post.id}/`} class="blog-card">
            <div class="blog-card-body">
              <div class="blog-meta">{post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</div>
              <h2>{post.data.title}</h2>
              <p style="color:var(--text-muted);font-size:0.95rem">{post.data.description}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
