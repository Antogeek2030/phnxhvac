---
import Layout from '../layouts/Layout.astro';
const phone = '+16105550199';
const phoneDisplay = '(610) 555-0199';
---
<Layout title="Contact Us | HVAC Repair Phoenixville PA" description="Call or reach out for same-day HVAC repair in Phoenixville, PA. 25 Gay St, Phoenixville, PA 19460.">
  <section class="page-hero">
    <div class="container">
      <h1>Contact Us</h1>
      <p>Same-day appointments often available. Call or message us today.</p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="grid-2">
        <div>
          <h2 class="section-title" style="font-size:1.5rem">Get in Touch</h2>
          <p style="margin-bottom:1rem"><strong>Phone:</strong> <a href={`tel:${phone}`}>{phoneDisplay}</a></p>
          <p style="margin-bottom:1rem"><strong>Address:</strong><br />25 Gay St<br />Phoenixville, PA 19460</p>
          <p style="margin-bottom:1rem"><strong>Hours:</strong> Open 24/7 for emergencies</p>
          <p style="color:var(--text-muted)">For non-urgent requests, call during business hours and we will schedule a convenient window.</p>
        </div>
        <div class="map-wrap">
          <iframe title="Map of 25 Gay St Phoenixville" src="https://www.openstreetmap.org/export/embed.html?bbox=-75.5249%2C40.1204%2C-75.5049%2C40.1404&amp;layer=mapnik&amp;marker=40.1304%2C-75.5149" loading="lazy"></iframe>
        </div>
      </div>
    </div>
  </section>
</Layout>
