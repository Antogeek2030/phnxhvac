---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Service Areas | HVAC Repair Phoenixville PA" description="HVAC repair service areas: Phoenixville, Spring City, Royersford, Collegeville, Malvern, King of Prussia, West Chester, Pottstown and Chester County.">
  <section class="page-hero">
    <div class="container">
      <h1>Service Areas</h1>
      <p>Proudly serving Phoenixville and surrounding Chester County communities.</p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <p class="section-sub">We provide same-day and emergency HVAC repair throughout the following areas:</p>
      <div class="grid-3">
        <div class="card"><h3>Phoenixville</h3><p>Our home base — fastest response times.</p></div>
        <div class="card"><h3>Spring City</h3><p>Minutes away for rapid service.</p></div>
        <div class="card"><h3>Royersford</h3><p>Regular coverage for AC and furnace calls.</p></div>
        <div class="card"><h3>Collegeville</h3><p>Full HVAC repair and maintenance.</p></div>
        <div class="card"><h3>Malvern</h3><p>Residential heating and cooling specialists.</p></div>
        <div class="card"><h3>King of Prussia</h3><p>Same-day service available.</p></div>
        <div class="card"><h3>West Chester</h3><p>Chester County coverage.</p></div>
        <div class="card"><h3>Pottstown</h3><p>Emergency and scheduled repairs.</p></div>
        <div class="card"><h3>Surrounding Towns</h3><p>Kimberton, Oaks, Trappe, Exton, and more.</p></div>
      </div>
      <p style="margin-top:2rem;color:var(--text-muted)">Not sure if we cover your neighborhood? Call us — we often serve additional nearby locations.</p>
    </div>
  </section>
</Layout>
